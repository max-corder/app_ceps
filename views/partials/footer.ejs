<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Script PWA & Enstalasyon Mobile -->
<script>
let deferredPrompt = null;

// Anrejistre Service Worker pou PWA
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
            .then((reg) => {
                console.log('CEPS Service Worker anrejistre avèk siksè:', reg.scope);
            })
            .catch((err) => {
                console.warn('Erè anrejistreman Service Worker:', err);
            });
    });
}

// Detekte 'beforeinstallprompt' pou Android / Chrome
window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    const btn = document.getElementById('btnPWAInstall');
    if (btn) {
        btn.style.display = 'inline-flex';
    }
});

// Lè aplikasyon an fin enstale
window.addEventListener('appinstalled', () => {
    console.log('CEPS Santé enstale sou aparèy la!');
    deferredPrompt = null;
    const btn = document.getElementById('btnPWAInstall');
    if (btn) btn.style.display = 'none';
});

// Ouvri modal oswa lanse enstalasyon
function declencherInstallation() {
    const modalEl = document.getElementById('modalPWAInstall');
    if (modalEl && typeof bootstrap !== 'undefined') {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    } else if (deferredPrompt) {
        lancerInstallationDirecte();
    }
}

async function lancerInstallationDirecte() {
    if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        console.log('Rezilta enstalasyon itilizatè a:', outcome);
        deferredPrompt = null;
        const modalEl = document.getElementById('modalPWAInstall');
        if (modalEl && typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }
    } else {
        alert('Pou enstale sou Android: klike sou 3 ti pwen Chrome yo epi chwazi "Ajoute sou ekran dakèy".');
    }
}

// Detekte koneksyon entènèt (Online / Offline)
function mettreAJourStatutLiy() {
    const toast = document.getElementById('pwaOfflineToast');
    if (!toast) return;
    if (!navigator.onLine) {
        toast.style.display = 'flex';
    } else {
        toast.style.display = 'none';
    }
}
window.addEventListener('online', mettreAJourStatutLiy);
window.addEventListener('offline', mettreAJourStatutLiy);
mettreAJourStatutLiy();
</script>
