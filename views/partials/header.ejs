<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= NOM_ENTREPRISE %></title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
<header class="ceps-header">
    <div class="ceps-container ceps-nav">
        <a href="/index.php?page=accueil" class="ceps-logo">
            <img src="/assets/images/logo_ceps.jpeg" alt="Logo CEPS" class="ceps-logo-img">
            CEPS
        </a>

        <!-- Barre de recherche universelle par nom de produit -->
        <form method="get" action="/index.php" class="ceps-recherche">
            <input type="hidden" name="page" value="recherche_produit">
            <input type="search" name="q" placeholder="Rechercher un produit..." value="<%= typeof q !== 'undefined' ? q : '' %>" required>
            <button type="submit"><i class="bi bi-search"></i></button>
        </form>

        <button type="button" 
            class="ceps-menu-toggle d-lg-none" 
            onclick="ouvrirMenu()" 
            aria-label="Menu">
            <i class="bi bi-list"></i>
        </button>

        <nav class="ceps-menu" id="cepsMenu">
            <% const current = typeof pageActive !== 'undefined' ? pageActive : 'accueil'; %>
            <% const curType = typeof reqQuery !== 'undefined' ? reqQuery.type : ''; %>
            <a href="/index.php?page=accueil" class="<%= current === 'accueil' ? 'active' : '' %>">Accueil</a>
            <a href="/index.php?page=galerie" class="<%= current === 'galerie' && !curType ? 'active' : '' %>">Produits</a>
            <a href="/index.php?page=galerie&type=cosmetique" class="<%= current === 'galerie' && curType === 'cosmetique' ? 'active' : '' %>">Cosmétiques</a>
            <a href="/index.php?page=galerie&type=pharmaceutique" class="<%= current === 'galerie' && curType === 'pharmaceutique' ? 'active' : '' %>">Médicaments</a>
            <a href="/index.php?page=apropos" class="<%= current === 'apropos' ? 'active' : '' %>">À propos</a>
            <a href="/index.php?page=contact" class="<%= current === 'contact' ? 'active' : '' %>">Contact</a>
            
            <% const nbrPanier = Object.keys(panier || {}).length; %>
            <a href="/index.php?page=panier" class="<%= current === 'panier' ? 'active' : '' %>">
                Panier<% if (nbrPanier > 0) { %> (<%= nbrPanier %>)<% } %>
            </a>

            <% if (user && user.nom_role === 'client') { %>
                <a href="/index.php?page=client_historique" class="<%= current === 'client_historique' ? 'active' : '' %>">Historique</a>
                <a href="/index.php?page=client_chat" class="<%= current === 'client_chat' ? 'active' : '' %>">Chat</a>
                <a href="/index.php?page=client_profil" class="<%= current === 'client_profil' ? 'active' : '' %>">Mon profil</a>
                <a href="/index.php?page=deconnexion">Déconnexion</a>
            <% } else if (user && user.nom_role === 'admin') { %>
                <a href="/index.php?page=admin_dashboard" class="<%= current === 'admin_dashboard' ? 'active' : '' %>">Tableau de bord</a>
                <a href="/index.php?page=deconnexion">Déconnexion</a>
            <% } else if (user && user.nom_role === 'caissier') { %>
                <a href="/index.php?page=caissier_dashboard" class="<%= current === 'caissier_dashboard' ? 'active' : '' %>">Caisse</a>
                <a href="/index.php?page=deconnexion">Déconnexion</a>
            <% } else { %>
                <a href="/index.php?page=login" class="ceps-btn-nav <%= current === 'login' ? 'active' : '' %>">Connexion</a>
                <a href="/index.php?page=inscription" class="ceps-btn-nav <%= current === 'inscription' ? 'active' : '' %>">Inscription</a>
            <% } %>
        </nav>
    </div>
</header>

<main class="ceps-container" style="padding-top: 1.5rem; padding-bottom: 2rem;">

<% if (flash_success) { %>
    <div class="ceps-alert ceps-alert-succes" style="background: #e6f7ef; color: #0a6644; border: 1px solid #12c98a; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <%= flash_success %>
    </div>
<% } %>

<% if (flash_erreur) { %>
    <div class="ceps-alert ceps-alert-danger" style="background: #fdeaea; color: #d64545; border: 1px solid #d64545; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <%= flash_erreur %>
    </div>
<% } %>

<script>
function ouvrirMenu() {
    const menu = document.getElementById('cepsMenu');
    menu.classList.toggle('ouvert');
}
</script>
