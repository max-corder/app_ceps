<%- include('../partials/header') %>

<section class="ceps-section">
    <h2>Détails de la commande #<%= idCommande %></h2>

    <table class="ceps-table">
        <thead><tr><th>Produit</th><th>Quantité</th><th>Prix négocié</th><th>Sous-total</th><th>Modifier le prix</th></tr></thead>
        <tbody>
        <% for (const ligne of details) { %>
            <tr>
                <td><%= ligne.nom_produit %></td>
                <td><%= ligne.quantite %></td>
                <td><%= Number(ligne.prix_unitaire_negocie).toFixed(2) %> $</td>
                <td><%= Number(ligne.sous_total).toFixed(2) %> $</td>
                <td>
                    <form method="post" action="/index.php?page=admin_commande_prix" class="ceps-form-inline" onsubmit="return confirm('Confirmer la modification du prix ?')">
                        <input type="hidden" name="id_commande" value="<%= idCommande %>">
                        <input type="hidden" name="id_produit" value="<%= ligne.id_produit %>">
                        <input type="number" step="0.01" name="nouveau_prix" placeholder="Nouveau prix" required style="width:110px;">
                        <button type="submit" class="ceps-btn ceps-btn-petit">Négocier</button>
                    </form>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>

    <p class="ceps-total" style="font-weight:700; margin:1rem 0;">Total actuel : <%= Number(order.montant_total).toFixed(2) %> $</p>

    <% if (order.montant_acompte) { %>
        <div class="ceps-alert ceps-alert-info" style="background:#e8f4fd; color:#1c6fd6; border:1px solid #bce0fd; padding:1rem; border-radius:8px; margin-bottom:1.5rem;">
            <span>
                💰 Le client a envoyé un dépôt de <strong><%= Number(order.montant_acompte).toFixed(2) %> $</strong>
                via <%= (order.mode_paiement_acompte || '').toUpperCase() %> le <%= order.date_acompte %>.
            </span>
            <% if (order.preuve_acompte) { %>
                <a href="/uploads/preuves/<%= order.preuve_acompte %>" target="_blank" class="ceps-btn ceps-btn-petit" style="margin-left:10px;">Voir la preuve</a>
            <% } %>
        </div>
    <% } %>

    <div style="display:flex; gap:1rem; margin-top:1.5rem;">
        <form method="post" action="/index.php?page=admin_commande_approuver" class="ceps-form-inline"
              onsubmit="return confirm('Approuver cette commande ?')">
            <input type="hidden" name="id" value="<%= idCommande %>">
            <button type="submit" class="ceps-btn">✔ Approuver la commande</button>
        </form>
        <a href="/index.php?page=admin_commandes" class="ceps-btn ceps-btn-secondaire">Retour à la liste</a>
    </div>
</section>

<%- include('../partials/footer') %>
