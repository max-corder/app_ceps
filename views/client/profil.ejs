<%- include('../partials/header') %>

<section class="ceps-section">
    <h2>Mon profil</h2>

    <div class="ceps-profil-photo" style="margin-bottom: 1.5rem;">
        <% if (profil.photo_profil) { %>
            <img src="/uploads/profils/<%= profil.photo_profil %>" alt="Photo de profil" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover;">
        <% } else { %>
            <div class="ceps-avatar-defaut" style="width: 80px; height: 80px; border-radius: 50%; background: #eef5f1; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">👤</div>
        <% } %>
    </div>

    <form method="post" action="/index.php?page=client_profil_modifier" enctype="multipart/form-data" class="ceps-form">
        <label>Nom
            <input type="text" name="nom" value="<%= profil.nom || '' %>" required>
        </label>
        <label>Prénom
            <input type="text" name="prenom" value="<%= profil.prenom || '' %>" required>
        </label>
        <label>Téléphone
            <input type="text" name="telephone" value="<%= profil.telephone || '' %>">
        </label>
        <label>Photo de profil (facultatif)
            <input type="file" name="photo" accept="image/*">
        </label>
        <button type="submit" class="ceps-btn">Enregistrer</button>
    </form>

    <h3 style="margin-top: 2rem;">Changer mon mot de passe</h3>
    <form method="post" action="/index.php?page=client_mdp_modifier" class="ceps-form" onsubmit="return confirm('Confirmer le changement de mot de passe ?')">
        <label>Ancien mot de passe
            <input type="password" name="ancien_mot_de_passe" required>
        </label>
        <label>Nouveau mot de passe
            <input type="password" name="nouveau_mot_de_passe" minlength="8" required>
        </label>
        <label>Confirmation
            <input type="password" name="confirmation" minlength="8" required>
        </label>
        <button type="submit" class="ceps-btn">Modifier le mot de passe</button>
    </form>

    <h3 style="margin-top: 2rem;">Localisation pour livraison</h3>
    <p>Autorisez CEPS à accéder à votre position pour une meilleure livraison.</p>
    <button type="button" class="ceps-btn" onclick="demanderLocalisation()">Partager ma position</button>
    <p id="statutLocalisation" style="margin-top: 0.5rem; font-weight: 500;"></p>

    <h3 style="margin-top: 2rem;">Laisser un commentaire</h3>
    <form method="post" action="/index.php?page=client_commentaire" class="ceps-form">
        <label>Votre avis
            <textarea name="texte" rows="3" required></textarea>
        </label>
        <label>Note (1 à 5)
            <input type="number" name="note" min="1" max="5" value="5">
        </label>
        <button type="submit" class="ceps-btn">Envoyer</button>
    </form>
</section>

<script>
function demanderLocalisation() {
    const statut = document.getElementById('statutLocalisation');
    if (!navigator.geolocation) {
        statut.textContent = "La géolocalisation n'est pas supportée par votre navigateur.";
        return;
    }
    statut.textContent = "Récupération de vos coordonnées...";
    navigator.geolocation.getCurrentPosition(
        (pos) => {
            fetch('/index.php?page=client_localisation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `latitude=${pos.coords.latitude}&longitude=${pos.coords.longitude}`
            }).then(() => {
                statut.textContent = "Position enregistrée avec succès !";
                statut.style.color = "#0a6644";
            }).catch(() => {
                statut.textContent = "Erreur lors de l'enregistrement.";
            });
        },
        () => {
            statut.textContent = "Accès à la position refusé.";
        }
    );
}
</script>

<%- include('../partials/footer') %>
