<%- include('partials/header') %>

<div class="ceps-container" style="max-width: 860px; margin: 0 auto; padding: 1.5rem 0.5rem 3rem;">
    <!-- En-tête de téléchargement -->
    <div style="background: linear-gradient(135deg, #0f766e, #0d9488); color: white; border-radius: 20px; padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 10px 30px rgba(15, 118, 110, 0.25); margin-bottom: 2rem;">
        <div style="width: 85px; height: 85px; margin: 0 auto 1.25rem; background: white; border-radius: 22px; padding: 6px; box-shadow: 0 8px 20px rgba(0,0,0,0.2);">
            <img src="/pwa-192x192.png" alt="Logo CEPS" style="width: 100%; height: 100%; object-fit: contain; border-radius: 16px;">
        </div>
        <span style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); padding: 5px 14px; border-radius: 30px; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 0.75rem;">
            <i class="bi bi-android2 text-warning"></i> Aplikasyon Android Ofisyèl (PWA / APK)
        </span>
        <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">Telechaje CEPS Santé sou Telefòn ou</h1>
        <p style="font-size: 1.05rem; opacity: 0.9; max-width: 600px; margin: 0 auto 1.5rem;">
            Achte medikaman ak ekipman medikal dirèkteman sou telefòn ou, resevwa notifikasyon kòmand, epi chat an dirèk san pase pa navigatè.
        </p>

        <!-- Bouton Enstalasyon Dirèk -->
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <button onclick="declencherInstallation()" style="background: #ffffff; color: #0f766e; border: none; font-size: 1.15rem; font-weight: 700; padding: 14px 28px; border-radius: 14px; box-shadow: 0 8px 20px rgba(0,0,0,0.15); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i class="bi bi-download" style="font-size: 1.3rem;"></i> 1. Enstale Dirèk sou Android
            </button>
            <a href="javascript:void(0)" onclick="window.open('https://www.pwabuilder.com?site=' + encodeURIComponent(window.location.origin), '_blank')" style="background: rgba(255,255,255,0.15); color: #ffffff; border: 2px solid rgba(255,255,255,0.6); font-size: 1.05rem; font-weight: 600; padding: 14px 24px; border-radius: 14px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                <i class="bi bi-box-arrow-up-right"></i> 2. Telechaje Pake .APK
            </a>
        </div>
    </div>

    <!-- Etap Enstalasyon Rapid sou Chrome -->
    <div style="background: white; border-radius: 18px; padding: 2rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 2rem;">
        <h3 style="font-size: 1.3rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
            <i class="bi bi-phone-fill text-success"></i> Kijan pou w enstale l nan 10 segonn :
        </h3>

        <div class="row g-4">
            <div class="col-md-4">
                <div style="background: #f8fafc; padding: 1.25rem; border-radius: 12px; height: 100%; border: 1px solid #e2e8f0;">
                    <div style="width: 38px; height: 38px; background: #0f766e; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 0.75rem;">1</div>
                    <h5 style="font-size: 1rem; font-weight: 700;">Louvri nan Google Chrome</h5>
                    <p style="font-size: 0.9rem; color: #64748b; margin: 0;">Asire w ou louvri sit sa a nan navigatè <strong>Google Chrome</strong> sou telefòn Android ou.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div style="background: #f8fafc; padding: 1.25rem; border-radius: 12px; height: 100%; border: 1px solid #e2e8f0;">
                    <div style="width: 38px; height: 38px; background: #0f766e; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 0.75rem;">2</div>
                    <h5 style="font-size: 1rem; font-weight: 700;">Klike sou 3 ti pwen yo (⋮)</h5>
                    <p style="font-size: 0.9rem; color: #64748b; margin: 0;">Gade anwo adwat nan ekran an sou Chrome, klike sou <strong>3 ti pwen vètikal yo</strong>.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div style="background: #f8fafc; padding: 1.25rem; border-radius: 12px; height: 100%; border: 1px solid #e2e8f0;">
                    <div style="width: 38px; height: 38px; background: #0f766e; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 0.75rem;">3</div>
                    <h5 style="font-size: 1rem; font-weight: 700;">Chwazi "Enstale App"</h5>
                    <p style="font-size: 0.9rem; color: #64748b; margin: 0;">Klike sou <strong>"Enstale aplikasyon an"</strong> oswa <strong>"Ajoute sou ekran dakèy"</strong>. Li fini!</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Karakteristik Aplikasyon an -->
    <div style="background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 16px; padding: 1.5rem; text-align: center;">
        <h4 style="font-size: 1.1rem; font-weight: 700; color: #0f766e; margin-bottom: 0.5rem;">Poukisa enstale aplikasyon CEPS Santé la ?</h4>
        <div class="d-flex flex-wrap justify-content-center gap-4 mt-3" style="color: #115e59; font-size: 0.95rem;">
            <span><i class="bi bi-check-circle-fill text-emerald-600"></i> Pa bezwen tape adrès la ankò</span>
            <span><i class="bi bi-check-circle-fill text-emerald-600"></i> Pi rapid pase yon sit wèb nòmal</span>
            <span><i class="bi bi-check-circle-fill text-emerald-600"></i> Sekirite total pou peman MonCash & Natcash</span>
            <span><i class="bi bi-check-circle-fill text-emerald-600"></i> Pran mwens pase 1 MB espas</span>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
